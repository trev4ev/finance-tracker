# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon JWT also works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Optional. Used by /api/auth/account if the password-account Edge Function is not deployed.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Plaid (https://dashboard.plaid.com/developers/keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
# Optional. Any passphrase is hashed to a 32-byte AES key.
# Generate one with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=
