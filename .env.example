# Supabase (Project Settings → API) — baked into the static client at build time
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy anon JWT also works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# GitHub Pages project site (omit for local `next dev` or a custom domain at the origin root)
# NEXT_PUBLIC_BASE_PATH=/finance-tracker

# Plaid secrets belong on the Supabase Edge Function, not in this file:
#   supabase secrets set PLAID_CLIENT_ID=... PLAID_SECRET=... PLAID_ENV=sandbox PLAID_TOKEN_ENCRYPTION_KEY=...
#
# Unused-credit SMS (optional; Settings stores the phone number):
#   supabase secrets set CREDIT_REMINDER_SECRET=$(openssl rand -hex 32)
#   supabase secrets set TEXTBELT_KEY=...   # omit to use TextBelt's free 1 SMS/day key
